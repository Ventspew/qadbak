upstream account_api {
    server account-api:4242;
}

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    set $pogo_api_key "${ACCOUNT_API_KEY}";

    location = /api/health {
        proxy_pass http://account_api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        add_header Cache-Control "no-store" always;
    }

    location = /api/docs {
        proxy_pass http://account_api/docs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    location = /api/openapi.json {
        proxy_pass http://account_api/openapi.json;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    location = /api/accounts {
        proxy_pass http://account_api/account;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $pogo_api_key;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location /api/accounts/ {
        proxy_pass http://account_api/account/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $pogo_api_key;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location = /map {
        return 302 ${MAP_PUBLIC_URL};
    }
    location /map/ {
        # ReactMap cannot live under a subpath (absolute /assets → white page).
        return 302 ${MAP_PUBLIC_URL};
    }

    location = /koji {
        return 302 ${KOJI_PUBLIC_URL};
    }
    location /koji/ {
        return 302 ${KOJI_PUBLIC_URL};
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
