# Generated by scripts/install-dragonite.sh / render-config.sh — adjust secrets as needed.

[general]
api_host = "0.0.0.0"
api_port = 7272
stats = true

[auth.ptc]
enable = false

[auth.nk]
enable = false

[rotom]
endpoint = "ws://rotom:7071"
#secret = ""

[processors]
golbat_endpoint = "http://golbat:9001"
golbat_raw_bearer = "${GOLBAT_RAW_BEARER}"
golbat_api_secret = "${GOLBAT_API_SECRET}"

[logging]
save = true

[db.dragonite]
host = "mariadb"
port = 3306
user = "${DB_USER}"
password = "${DB_PASSWORD}"
name = "dragonite"
pool_size = 2
