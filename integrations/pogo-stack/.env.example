# Copy to .env and fill in before deploy: cp .env.example .env

# Database
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-pogo
DB_NAME=pogo
DB_USER=pogo

# Account API
ACCOUNT_API_KEY=change-me-api-key
ACCOUNT_API_PORT=14242

# Dashboard login (browser). Qadbak reverse-proxies 127.0.0.1:18080.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-dashboard-password
DASHBOARD_PORT=18080
DASHBOARD_SECRET=change-me-dashboard-secret
REACTMAP_PORT=18081
KOJI_PORT=18082

# Golbat
GOLBAT_API_SECRET=golbat-secret
GOLBAT_RAW_BEARER=

# Koji
KOJI_BEARER_TOKEN=change-me-koji-token

# PoracleNG
PORACLE_SECRET=change-me-poracle

# ReactMap
REACTMAP_SECRET=change-me-reactmap
MAP_START_LAT=52.3676
MAP_START_LON=4.9041

# Domain base (for Qadbak reverse proxy docs)
POGO_DOMAIN=pogo.example.com
# MAP_PUBLIC_URL=https://map.example.com/
# KOJI_PUBLIC_URL=https://koji.example.com/

# --- Deviceless workers (Redroid + Cosmog) ---
# Image is picked per CPU: official Redroid on x86, Magisk ARM image on ARM64.
# Override if you have a custom image.
REDROID_IMAGE=redroid/redroid:11.0.0-latest
REDROID_INSTANCES=2
COSMOG_WORKERS_PER_CONTAINER=17
COSMOG_TOKEN=change-me-cosmog-token
ROTOM_SECRET=change-me-rotom-secret
SERVER_PUBLIC_IP=127.0.0.1
WORKER_PUSH_INTERVAL=60
HOUNDOUR_INTERVAL=120

# --- Physical Android (Cosmog on a phone / ATV) ---
# IP or hostname the PHONE can reach (not 127.0.0.1). LAN IP or VPS public IP.
# ROTOM_PUBLIC_WS=ws://192.168.1.20:7070
ROTOM_DEVICE_PORT=7070
ROTOM_CONTROLLER_PORT=7071
ROTOM_UI_PORT=7072
ROTOM_INTERNAL_WS=ws://rotom:7070
ANDROID_WORKERS_PER_DEVICE=8
# Unique Cosmog device_ids (comma-separated), used when rendering configs
# ANDROID_DEVICE_IDS=pixel-1
# Wireless ADB keep-alive from the VPS: name@host:port
# ANDROID_DEVICES=pixel-1@192.168.1.42:5555

# --- Jailbroken iPhone (Exeggcute / GC) ---
# Same ROTOM_PUBLIC_WS as Android — both join one Rotom pool.
EXEGGCUTE_API_KEY=change-me-exeggcute-key
IOS_WORKERS_PER_DEVICE=4
# IOS_DEVICE_IDS=iphone-1
# Wireless SSH keep-alive from the VPS: name@host:port
# IOS_DEVICES=iphone-1@192.168.1.50:22
IOS_SSH_USER=root
# IOS_SSH_PASSWORD=alpine
